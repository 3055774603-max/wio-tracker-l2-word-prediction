     def is_common_builder(self, root_path, child_path):
+        # PATCH(l2): the verdict depends only on the two path strings, and the
+        # same pairs are tested millions of times during the dependency scan.
+        cache = LibBuilderBase._IS_COMMON_BUILDER_CACHE
+        key = (root_path, child_path)
+        cached = cache.get(key)
+        if cached is not None:
+            return cached
+        cached = self._is_common_builder_uncached(root_path, child_path)
+        cache[key] = cached
+        return cached
+
+    @staticmethod
+    def _isfile_cached(path):
+        # PATCH(l2): the header->source probe stats the same handful of paths
+        # once per library scan. Nothing creates or deletes files while the
+        # dependency graph is being resolved, so the answer can be memoised.
+        cache = LibBuilderBase._ISFILE_CACHE
+        hit = cache.get(path)
+        if hit is None:
+            hit = os.path.isfile(path)
+            cache[path] = hit
+        return hit
+
+    @staticmethod
+    def _realpath_cached(path):
+        # PATCH(l2): os.path.realpath() on Windows resolves every path element
+        # through the filesystem; the same handful of roots is resolved over
+        # and over, so memoise it.
+        cache = LibBuilderBase._REALPATH_CACHE
+        resolved = cache.get(path)
+        if resolved is None:
+            resolved = os.path.realpath(path)
+            cache[path] = resolved
+        return resolved
+
